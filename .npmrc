# Pin npm's default dependency layout for this project.
#
# A user-level `install-strategy=nested` on the machine this was built on leaked
# into the committed lockfile: ~4,500 install entries for ~480 distinct
# packages, which every `npm ci` in CI and on Vercel then reproduced -- and
# which filled a development disk. A project setting takes precedence over user
# configuration, so installs are the same on every machine.
install-strategy=hoisted
