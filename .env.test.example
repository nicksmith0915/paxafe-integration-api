# The integration suite truncates every table, and refuses to run if
# TEST_DATABASE_URL is the database the application itself is configured with.
#
# Local equivalent of the CI database, for running the persistence tests:
#   docker run --rm -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_DB=pxtest --name pxtest postgres:16-alpine
#   DATABASE_URL=... npm run db:migrate && npm test
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pxtest"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pxtest"
API_KEYS="local_test_key"
